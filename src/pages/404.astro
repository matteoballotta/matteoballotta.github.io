---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      .hero {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
      }

      .hero-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        filter: brightness(50%);
      }

      .hero-content {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        z-index: 1;
      }

      .hero-content h1, p {
        color: rgb(var(--gray-light))
      }
    </style>
  </head>

  <body>
    <main>
      <article>
        <div class="hero">
          <video
            class="hero-video"
            autoplay
            muted
            loop
            playsinline
            aria-hidden="true"
          >
            <source src="/cat.mp4" type="video/mp4" />
          </video>

          <div class="hero-content">
            <h1>404 - Not Found</h1>
            <a href="/">Back to home</a>
            <p>Video curtesy: <a href="https://www.pexels.com/@luz-calor-som-99374650/">Luz Calor Som</a></p>
          </div>
        </div>
      </article>
    </main>
  </body>
</html>
